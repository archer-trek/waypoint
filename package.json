{
  "name": "waypoint",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"src/waypoint/integration/**\"",
    "test:integration": "vitest run src/waypoint/integration",
    "lint": "eslint .",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "prepare": "node -e \"import('node:fs').then(async ({existsSync})=>{if(!existsSync('.git'))return;const {spawnSync}=await import('node:child_process');spawnSync('git',['config','core.hooksPath','.githooks'],{stdio:'ignore'});})\"",
    "build:android": "node scripts/build-android-apk.mjs",
    "build:macos": "node scripts/build-macos-dmg.mjs",
    "build:windows": "node scripts/build-windows-installer.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:tag": "node scripts/tag-release.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@streamdown/cjk": "^1.0.5",
    "@streamdown/code": "^2.0.1",
    "@streamdown/math": "^1.0.4",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "streamdown": "^2.8.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
