{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waypoint",
  "version": "0.1.0",
  "identifier": "app.waypoint.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Waypoint",
        "width": 960,
        "height": 680,
        "minWidth": 768,
        "minHeight": 540,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
